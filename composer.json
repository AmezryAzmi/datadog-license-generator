{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "example/datadog-license-generator",
  "type": "project",
  "description": "Stateless Laravel generator for Datadog license usage dashboards and monitors.",
  "keywords": ["laravel", "datadog", "observability", "license", "generator"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "php artisan key:generate --ansi"
    ],
    "test": [
      "php artisan test"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
